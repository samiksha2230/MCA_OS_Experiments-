    "import psutil\n",
    "\n",
    "# Get network I/O statistics\n",
    "net_io = psutil.net_io_counters()\n",
    "\n",
    "print(\"Network Statistics:\\n\")\n",
    "print(f\"Bytes Sent: {net_io.bytes_sent}\")\n",
    "print(f\"Bytes Received: {net_io.bytes_recv}\")\n"
   ]
  }
